#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp R     &kp T    &kp Y  &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D      &kp F     &kp G    &kp H  &kp J     &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT  &kp Z  &kp X  &kp C      &kp V     &kp B    &kp N  &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp DEL
                         &kp SPACE  &mkp MB1  &mo 1    &mo 1  &mkp MB2  &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &none         &none     &none     &kp MINUS  &kp EQUAL    &kp N7  &kp N8    &kp N9  &kp N0  &kp BACKSLASH  &rgb_ug RGB_TOG
&trans     &none         &trans    &trans    &kp UP     &none        &kp N4  &kp N5    &kp N6  &trans  &kp LBKT       &kp RBKT
&trans     &kp LEFT_GUI  &kp LALT  &kp LEFT  &kp DOWN   &kp RIGHT    &kp N1  &kp N2    &kp N3  &trans  &kp LEFT_GUI   &bt BT_CLR_ALL
                                   &kp TAB   &mkp MB5   &mo 2        &mo 2   &mkp MB4  &trans
            >;
        };

        layer_2 {
            bindings = <
&none        &none  &none  &none           &none           &none              &kp F7  &kp F8  &kp F9  &kp F12  &none  &rgb_ug RGB_COLOR_HSB(0,0,100)
&none        &none  &none  &none           &msc SCRL_UP    &none              &kp F4  &kp F5  &kp F6  &kp F11  &none  &none
&bootloader  &none  &none  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT    &kp F1  &kp F2  &kp F3  &kp F10  &none  &bootloader
                           &kp SPACE       &none           &none              &none   &none   &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
